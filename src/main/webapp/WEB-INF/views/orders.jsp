<%@ include file="header.jsp" %>
<h1>Your orders</h1><c:if test="${not empty sessionScope.flash}"><div class="notice"><c:out value="${sessionScope.flash}"/></div><c:remove var="flash" scope="session"/></c:if><c:if test="${empty orders}"><div class="panel"><p class="muted">Your order history is empty.</p></div></c:if><c:forEach var="order" items="${orders}"><div class="panel"><div style="display:flex;justify-content:space-between"><strong>Order #<c:out value="${order.id}"/></strong><span class="btn small secondary"><c:out value="${order.status}"/></span></div><p class="muted"><c:out value="${order.createdAt}"/> · Total ₹<c:out value="${order.totalAmount}"/></p><ul><c:forEach var="item" items="${order.items}"><li><c:out value="${item.productName}"/> × <c:out value="${item.quantity}"/> · ₹<c:out value="${item.unitPrice}"/></li></c:forEach></ul></div></c:forEach>
<%@ include file="footer.jsp" %>