<%@ include file="header.jsp" %>
<section class="panel"><div class="form-grid"><div><c:if test="${not empty product.imageUrl}"><img style="width:100%;max-height:420px;object-fit:cover;border-radius:14px" src="<c:out value='${product.imageUrl}'/>" alt="<c:out value='${product.name}'/>"></c:if></div><div class="stack"><span class="muted"><c:out value="${product.category}"/> · sold by <c:out value="${product.sellerName}"/></span><h1><c:out value="${product.name}"/></h1><p><c:out value="${product.description}"/></p><div class="price">₹<c:out value="${product.price}"/></div><p class="muted"><c:out value="${product.stockQty}"/> in stock</p><c:if test="${sessionScope.user.role == 'BUYER'}"><form method="post" action="${pageContext.request.contextPath}/app/cart/mutate" class="card-actions"><input type="hidden" name="action" value="add"><input type="hidden" name="productId" value="${product.id}"><input class="input" style="max-width:100px" type="number" name="quantity" min="1" max="${product.stockQty}" value="1"><button class="btn" type="submit">Add to cart</button></form></c:if></div></div></section>
<section class="panel"><h2>Reviews</h2><c:if test="${empty reviews}"><p class="muted">No reviews yet.</p></c:if><c:forEach var="review" items="${reviews}"><div style="border-bottom:1px solid var(--line);padding:12px 0"><strong><c:out value="${review.userName}"/></strong> <span class="stars"><c:forEach begin="1" end="${review.rating}">★</c:forEach></span><p><c:out value="${review.comment}"/></p></div></c:forEach></section>
<c:if test="${sessionScope.user.role == 'BUYER'}"><section class="panel"><h2>Review this product</h2><p class="muted">Reviews are accepted after an administrator marks a delivered purchase.</p><form class="stack" method="post" action="${pageContext.request.contextPath}/app/reviews"><input type="hidden" name="productId" value="${product.id}"><label>Rating<select name="rating"><option value="5">★★★★★</option><option value="4">★★★★</option><option value="3">★★★</option><option value="2">★★</option><option value="1">★</option></select></label><label>Comment<textarea name="comment" maxlength="1000" required></textarea></label><button class="btn">Submit review</button></form></section></c:if>
<%@ include file="footer.jsp" %>