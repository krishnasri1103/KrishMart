<%@ include file="header.jsp" %>
<section class="hero"><div><p class="muted">A little greener, every day.</p><h1>Good finds for a greener life.</h1><p>Discover thoughtful everyday essentials, botanical home accents, and reusable favourites from independent sellers.</p></div></section>
<form class="toolbar" method="get" action="${pageContext.request.contextPath}/products"><input class="input" name="q" value="<c:out value='${param.q}'/>" placeholder="Search products"><select name="category"><option value="">All categories</option><c:forEach var="category" items="${categories}"><option value="<c:out value='${category}'/>" ${param.category == category ? 'selected' : ''}><c:out value="${category}"/></option></c:forEach></select><button class="btn" type="submit">Search</button></form>
<c:if test="${empty products}"><div class="panel"><h2>No products found</h2><p class="muted">Try a different keyword or category.</p></div></c:if><div class="grid"><c:forEach var="product" items="${products}"><article class="card"><c:if test="${not empty product.imageUrl}"><img src="<c:out value='${product.imageUrl}'/>" alt="<c:out value='${product.name}'/>"></c:if><div class="card-body"><span class="muted"><c:out value="${product.category}"/> · <c:out value="${product.sellerName}"/></span><h3><a href="${pageContext.request.contextPath}/product?id=${product.id}"><c:out value="${product.name}"/></a></h3><p class="muted"><c:out value="${product.description}"/></p><div class="price">₹<c:out value="${product.price}"/></div><div class="card-actions"><c:choose><c:when test="${sessionScope.user.role == 'BUYER'}"><button class="btn" data-add-cart="<c:out value='${product.id}'/>">Add to cart</button></c:when><c:when test="${empty sessionScope.user}"><a class="btn" href="${pageContext.request.contextPath}/auth?action=login">Log in to buy</a></c:when></c:choose><span class="muted"><c:out value="${product.stockQty}"/> left</span></div></div></article></c:forEach></div>
<%@ include file="footer.jsp" %>