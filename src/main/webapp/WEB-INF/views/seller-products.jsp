<%@ include file="header.jsp" %>
<h1>My listings</h1><section class="panel"><h2>Add a listing</h2><form class="form-grid" method="post" action="${pageContext.request.contextPath}/seller/products"><input type="hidden" name="action" value="create"><label>Name<input class="input" name="name" required maxlength="180"></label><label>Category<input class="input" name="category" required maxlength="80"></label><label>Price<input class="input" name="price" type="number" step="0.01" min="0" required></label><label>Stock<input class="input" name="stockQty" type="number" min="0" required></label><label class="full">Image URL<input class="input" name="imageUrl" maxlength="1000" type="url"></label><label class="full">Description<textarea name="description" required maxlength="2000"></textarea></label><div class="full"><button class="btn">Publish listing</button></div></form></section><div class="grid"><c:forEach var="product" items="${products}"><article class="card"><div class="card-body"><span class="muted"><c:out value="${product.category}"/></span><h3><c:out value="${product.name}"/></h3><p><c:out value="${product.description}"/></p><strong>₹<c:out value="${product.price}"/> · <c:out value="${product.stockQty}"/> stock</strong><details><summary>Edit listing</summary><br><form class="stack" method="post" action="${pageContext.request.contextPath}/seller/products"><input type="hidden" name="action" value="edit"><input type="hidden" name="id" value="${product.id}"><input class="input" name="name" value="<c:out value='${product.name}'/>" required><input class="input" name="category" value="<c:out value='${product.category}'/>" required><input class="input" name="price" value="<c:out value='${product.price}'/>" type="number" step="0.01" required><input class="input" name="stockQty" value="<c:out value='${product.stockQty}'/>" type="number" min="0" required><input class="input" name="imageUrl" value="<c:out value='${product.imageUrl}'/>"><textarea name="description" required><c:out value="${product.description}"/></textarea><button class="btn">Save changes</button></form></details><form method="post" action="${pageContext.request.contextPath}/seller/products" onsubmit="return confirm('Remove this listing?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${product.id}"><button class="btn danger small">Delete</button></form></div></article></c:forEach></div>
<%@ include file="footer.jsp" %>