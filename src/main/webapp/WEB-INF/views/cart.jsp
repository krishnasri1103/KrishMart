<%@ include file="header.jsp" %>
<h1>Your cart</h1><c:if test="${not empty sessionScope.flash}"><div class="notice"><c:out value="${sessionScope.flash}"/></div><c:remove var="flash" scope="session"/></c:if><c:if test="${empty items}"><div class="panel"><p>Your cart is empty.</p><a class="btn" href="${pageContext.request.contextPath}/products">Browse products</a></div></c:if><c:if test="${not empty items}"><div class="panel table-wrap"><table class="table"><thead><tr><th>Product</th><th>Unit price</th><th>Quantity</th><th>Total</th><th></th></tr></thead><tbody><c:forEach var="item" items="${items}"><tr><td><c:out value="${item.productName}"/></td><td>₹<c:out value="${item.unitPrice}"/></td><td><form method="post" action="${pageContext.request.contextPath}/app/cart/mutate" class="card-actions"><input type="hidden" name="action" value="update"><input type="hidden" name="productId" value="${item.productId}"><input class="input" style="width:90px" type="number" name="quantity" min="1" max="${item.stockQty}" value="${item.quantity}"><button class="btn small secondary">Update</button></form></td><td>₹<c:out value="${item.lineTotal}"/></td><td><form method="post" action="${pageContext.request.contextPath}/app/cart/mutate"><input type="hidden" name="action" value="remove"><input type="hidden" name="productId" value="${item.productId}"><button class="btn small danger">Remove</button></form></td></tr></c:forEach></tbody></table><div style="text-align:right;margin-top:20px"><strong>Total: <span data-cart-total>₹<c:out value="${total}"/></span></strong> <a class="btn" href="${pageContext.request.contextPath}/app/checkout">Checkout</a></div></div></c:if>
<%@ include file="footer.jsp" %>