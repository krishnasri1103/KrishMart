<%@ include file="header.jsp" %>
<h1>Admin dashboard</h1><section class="panel"><h2>Users</h2><div class="table-wrap"><table class="table"><tr><th>Name</th><th>Email</th><th>Role</th><th>Created</th></tr><c:forEach var="user" items="${users}"><tr><td><c:out value="${user.name}"/></td><td><c:out value="${user.email}"/></td><td><c:out value="${user.role}"/></td><td><c:out value="${user.createdAt}"/></td></tr></c:forEach></table></div></section><section class="panel"><h2>Orders</h2><div class="table-wrap"><table class="table"><tr><th>Order</th><th>Buyer</th><th>Total</th><th>Status</th><th>Change</th></tr><c:forEach var="order" items="${orders}"><tr><td>#<c:out value="${order.id}"/></td><td><c:out value="${order.buyerName}"/></td><td>₹<c:out value="${order.totalAmount}"/></td><td><c:out value="${order.status}"/></td><td><form method="post" action="${pageContext.request.contextPath}/admin/dashboard"><input type="hidden" name="action" value="status"><input type="hidden" name="orderId" value="${order.id}"><select name="status"><option>PENDING</option><option>CONFIRMED</option><option>SHIPPED</option><option>DELIVERED</option><option>CANCELLED</option></select><button class="btn small">Save</button></form></td></tr></c:forEach></table></div></section><section class="panel"><h2>Listings moderation</h2><div class="table-wrap"><table class="table"><tr><th>Product</th><th>Seller</th><th>Category</th><th></th></tr><c:forEach var="product" items="${products}"><tr><td><c:out value="${product.name}"/></td><td><c:out value="${product.sellerName}"/></td><td><c:out value="${product.category}"/></td><td><form method="post" action="${pageContext.request.contextPath}/admin/dashboard" onsubmit="return confirm('Remove this listing?')"><input type="hidden" name="action" value="removeProduct"><input type="hidden" name="productId" value="${product.id}"><button class="btn danger small">Remove</button></form></td></tr></c:forEach></table></div></section>
<%@ include file="footer.jsp" %>