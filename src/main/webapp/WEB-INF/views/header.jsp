<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><c:out value="${param.title != null ? param.title : 'KrishMart'}"/> · KrishMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body>
<nav class="nav"><a class="brand" href="${pageContext.request.contextPath}/products">KrishMart</a><a href="${pageContext.request.contextPath}/products">Shop</a><c:if test="${not empty sessionScope.user && sessionScope.user.role == 'BUYER'}"><a href="${pageContext.request.contextPath}/app/cart">Cart</a><a href="${pageContext.request.contextPath}/app/orders">Orders</a></c:if><c:if test="${not empty sessionScope.user && sessionScope.user.role == 'SELLER'}"><a href="${pageContext.request.contextPath}/seller/products">My listings</a><a href="${pageContext.request.contextPath}/seller/orders">Incoming orders</a></c:if><c:if test="${not empty sessionScope.user && sessionScope.user.role == 'ADMIN'}"><a href="${pageContext.request.contextPath}/admin/dashboard">Admin</a></c:if><c:choose><c:when test="${not empty sessionScope.user}"><span class="muted"><c:out value="${sessionScope.user.name}"/></span><form method="post" action="${pageContext.request.contextPath}/auth" style="display:inline"><input type="hidden" name="action" value="logout"><button class="btn small secondary" type="submit">Log out</button></form></c:when><c:otherwise><a href="${pageContext.request.contextPath}/auth?action=login">Log in</a><a class="btn small" href="${pageContext.request.contextPath}/auth?action=register">Join</a></c:otherwise></c:choose></nav>
<main class="wrap">