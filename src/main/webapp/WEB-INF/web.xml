<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">
    <display-name>KrishMart</display-name>
    <listener><listener-class>com.krishna.krishmart.listener.DataSourceContextListener</listener-class></listener>
    <filter><filter-name>EncodingFilter</filter-name><filter-class>com.krishna.krishmart.filter.EncodingFilter</filter-class></filter>
    <filter-mapping><filter-name>EncodingFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
    <filter><filter-name>AuthFilter</filter-name><filter-class>com.krishna.krishmart.filter.AuthFilter</filter-class></filter>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/app/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/seller/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/admin/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/api/*</url-pattern></filter-mapping>
    <servlet><servlet-name>AuthServlet</servlet-name><servlet-class>com.krishna.krishmart.controller.AuthServlet</servlet-class></servlet>
    <servlet><servlet-name>ProductServlet</servlet-name><servlet-class>com.krishna.krishmart.controller.ProductServlet</servlet-class></servlet>
    <servlet><servlet-name>SellerProductServlet</servlet-name><servlet-class>com.krishna.krishmart.controller.SellerProductServlet</servlet-class></servlet>
    <servlet><servlet-name>CartServlet</servlet-name><servlet-class>com.krishna.krishmart.controller.CartServlet</servlet-class></servlet>
    <servlet><servlet-name>CartApiServlet</servlet-name><servlet-class>com.krishna.krishmart.controller.CartApiServlet</servlet-class></servlet>
    <servlet><servlet-name>OrderServlet</servlet-name><servlet-class>com.krishna.krishmart.controller.OrderServlet</servlet-class></servlet>
    <servlet><servlet-name>ReviewServlet</servlet-name><servlet-class>com.krishna.krishmart.controller.ReviewServlet</servlet-class></servlet>
    <servlet><servlet-name>AdminServlet</servlet-name><servlet-class>com.krishna.krishmart.controller.AdminServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>AuthServlet</servlet-name><url-pattern>/auth</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ProductServlet</servlet-name><url-pattern>/products</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ProductServlet</servlet-name><url-pattern>/product</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>SellerProductServlet</servlet-name><url-pattern>/seller/products</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>OrderServlet</servlet-name><url-pattern>/app/orders</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>OrderServlet</servlet-name><url-pattern>/app/checkout</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>OrderServlet</servlet-name><url-pattern>/seller/orders</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>OrderServlet</servlet-name><url-pattern>/admin/order-status</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>CartServlet</servlet-name><url-pattern>/app/cart</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>CartServlet</servlet-name><url-pattern>/app/cart/mutate</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>CartApiServlet</servlet-name><url-pattern>/api/cart</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ReviewServlet</servlet-name><url-pattern>/app/reviews</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>AdminServlet</servlet-name><url-pattern>/admin/dashboard</url-pattern></servlet-mapping>
    <session-config><session-timeout>30</session-timeout><cookie-config><http-only>true</http-only><secure>false</secure></cookie-config></session-config>
    <welcome-file-list><welcome-file>products</welcome-file></welcome-file-list>
    <error-page><error-code>403</error-code><location>/WEB-INF/views/error.jsp</location></error-page>
    <error-page><error-code>404</error-code><location>/WEB-INF/views/error.jsp</location></error-page>
    <error-page><exception-type>java.lang.Throwable</exception-type><location>/WEB-INF/views/error.jsp</location></error-page>
</web-app>